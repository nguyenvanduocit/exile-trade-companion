{
  "name": "exile-trade-companion",
  "version": "0.3.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenvanduocit/exile-trade-companion.git"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "check": "bun run test && bun run typecheck && bun run build",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@wxt-dev/module-vue": "^1.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@liveblocks/client": "^3.24.1",
    "@webext-core/messaging": "^4.0.0",
    "@wxt-dev/i18n": "^0.2.7",
    "lucide-vue-next": "^1.0.0",
    "reka-ui": "^2.10.4",
    "shared": "workspace:*",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.42"
  }
