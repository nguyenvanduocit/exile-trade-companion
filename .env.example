# Liveblocks public API key (an toàn để commit dạng ví dụ — public key được thiết kế để lộ trong client bundle).
# Lấy tại: https://liveblocks.io/dashboard -> project -> API keys -> Public key
VITE_LIVEBLOCKS_PUBLIC_KEY=pk_dev_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Datadog client token cho telemetry ẩn danh (client token được thiết kế để lộ trong bundle, KHÔNG phải API key).
# Lấy tại: https://app.datadoghq.com/organization-settings/client-tokens -> New Client Token
VITE_DATADOG_CLIENT_TOKEN=pubxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Site Datadog của org: datadoghq.com | us5.datadoghq.com | datadoghq.eu | ap1.datadoghq.com
VITE_DATADOG_SITE=datadoghq.com
